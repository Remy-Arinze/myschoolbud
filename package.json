{
  "name": "@agora/web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "lint:check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "audit:check": "node -e \"try { require('child_process').execSync('npm audit --omit=dev --audit-level=high', { stdio: 'inherit' }); } catch { console.warn('[check] npm audit reported high+ issues (not blocking). Run npm audit for details.'); }\"",
    "check:commit": "npm run typecheck && npm run audit:check",
    "check:push": "npm run build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:school-admin": "playwright test --project=school-admin",
    "test:e2e:roster-ui": "playwright test e2e/school-admin/ui-admit-students.spec.ts e2e/school-admin/ui-secondary-teachers.spec.ts --project=school-admin --headed",
    "push": "git push origin dev && git checkout staging && git merge dev --no-edit && git push origin staging && git checkout master && git merge staging --no-edit && git push origin master && git checkout dev",
    "generate-client": "openapi-typescript-codegen --input http://localhost:4000/api/swagger-json --output ./src/lib/api/generated --client axios"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openobserve/browser-logs": "^0.3.1",
    "@openobserve/browser-rum": "^0.3.1",
    "@radix-ui/react-select": "^2.2.6",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.16.16",
    "gsap": "^3.14.2",
    "lenis": "^1.3.18",
    "lucide-react": "^0.554.0",
    "next": "^16.3.4",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-country-region-selector": "^4.0.6",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.6",
    "react-hot-toast": "^2.6.0",
    "react-international-phone": "^4.8.0",
    "react-redux": "^9.0.4",
    "recharts": "^2.10.3",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.2.48",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "dotenv": "^17.4.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "openapi-typescript-codegen": "^0.25.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4"
  }
}
