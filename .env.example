# Backend API URL (required for auth and API calls)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Environment
NODE_ENV=development

# Apex used for “leave this portal” links. On the test env set https://dev.myschoolbud.com
# NEXT_PUBLIC_APEX_URL=https://myschoolbud.com

# Extra portal roots (defaults already include myschoolbud.com and dev.myschoolbud.com)
# NEXT_PUBLIC_PORTAL_ROOT_DOMAINS=myschoolbud.com,dev.myschoolbud.com
